APP_NAME="Webbangiay API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# 127.0.0.1 = MySQL chạy trong Docker (xem api/compose.yaml), publish ra host —
# đúng cho cả php artisan serve chạy trực tiếp trên máy (xem SETUP_WINDOWS.md)
# và `docker compose up -d mysql redis` không cần container app Laravel.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Access token (Bearer, ngắn hạn) + refresh token (HttpOnly cookie, dài hạn) —
# cả hai lưu trong Redis (xem App\Services\Auth\TokenBroker), không lưu DB.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=1209600
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=lax

# SPA cookie-based auth (Sanctum) — storefront (5174) Vite dev server.
# 5173 is reserved by Sail/compose.yaml for Laravel's own unused built-in
# Vite assets, so no frontend app may use it. A future admin-panel app
# should get its own port (e.g. 5175) added here, not reuse 5174.
SANCTUM_STATEFUL_DOMAINS=localhost:5180,127.0.0.1:5180,localhost:5175,127.0.0.1:5175
FRONTEND_STOREFRONT_URL=http://localhost:5180
FRONTEND_ADMIN_URL=http://localhost:5175

# MoMo payment credentials — reserved for later payment-integration phase, not used yet
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
