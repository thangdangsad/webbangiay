APP_NAME="SoleHouse API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shoe
DB_USERNAME=shoe
DB_PASSWORD=password

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=shoe:
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
SESSION_DRIVER=array

FILESYSTEM_DISK=public
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_STOREFRONT_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
STAFF_2FA_ENFORCED=false

