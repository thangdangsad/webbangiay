erDiagram
  brands ||--o{ products : "có"
  categories ||--o{ products : "chứa"
  categories ||--o{ categories : "cha - con"
  products ||--|{ product_variants : "có biến thể"
  products ||--o{ product_images : "có ảnh"
  colors ||--o{ product_variants : ""
  sizes ||--o{ product_variants : ""
  colors ||--o{ product_images : "ảnh theo màu"
  product_variants ||--|| inventory : "tồn kho"
  product_variants ||--o{ inventory_movements : "biến động"
